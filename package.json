{
  "name": "dont-lose-it-monorepo",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @dont-lose-it/api dev",
    "dev:mobile": "pnpm --filter @dont-lose-it/mobile start",
    "db:generate": "pnpm --filter @dont-lose-it/db generate",
    "db:migrate": "pnpm --filter @dont-lose-it/db migrate",
    "db:push": "pnpm --filter @dont-lose-it/db push",
    "db:studio": "pnpm --filter @dont-lose-it/db studio",
    "auth:generate": "pnpm --filter @dont-lose-it/api auth:generate",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  }
}
