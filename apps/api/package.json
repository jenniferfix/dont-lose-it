{
  "name": "@dont-lose-it/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "auth:generate": "node --env-file-if-exists=../../.env node_modules/auth/dist/index.mjs generate --config src/auth.ts --output ../../packages/db/src/schema/auth.ts -y",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/expo": "catalog:",
    "@dont-lose-it/db": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@hono/trpc-server": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.21",
    "superjson": "^2.2.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "auth": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
